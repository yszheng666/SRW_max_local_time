import SRWTightness.ContinuousLaplace

open MeasureTheory ProbabilityTheory
open scoped NNReal

namespace SRWTightness

/-- Projecting each independent reference mark preserves its actual product law. -/
theorem markProductLaw_restrict (D A K : Finset Site) (hAK : A ⊆ K) (hKD : K ⊆ D)
    (α : ℝ) (hα : 0 ≤ α) (hcap : α * capacity D K ≤ 1) (k : ℕ) :
    MeasurePreserving (fun Y : MarkSamples K k ↦ fun i ↦ restrictMark hAK (Y i))
      (markProductLaw D K α k) (markProductLaw D A α k) := by
  have hcA : α * capacity D A ≤ 1 :=
    (mul_le_mul_of_nonneg_left (capacity_mono_set D A K hAK hKD) hα).trans hcap
  letI := referenceMarkLaw_isProbabilityMeasure D A α hα hcA
  apply measurePreserving_pi
  intro i
  exact ⟨measurable_restrictMark hAK,
    referenceMark_restriction_law D A K hAK hKD α hα hcap⟩

/-- Count marks on K, retaining only the coordinates in A. -/
noncomputable def projectedCountKernel (D A K : Finset Site) (hAK : A ⊆ K) (α : ℝ) :
    Kernel ℕ (Mark A) where
  toFun k := (markProductLaw D K α k).map (fun Y ↦ restrictMark hAK (sumMarks K k Y))
  measurable' := measurable_of_countable _

 theorem projectedCountKernel_eq (D A K : Finset Site) (hAK : A ⊆ K) (hKD : K ⊆ D)
    (α : ℝ) (hα : 0 ≤ α) (hcap : α * capacity D K ≤ 1) :
    projectedCountKernel D A K hAK α = markCountKernel D A α := by
  ext k : 1
  change (markProductLaw D K α k).map (fun Y ↦ restrictMark hAK (sumMarks K k Y)) =
    (markProductLaw D A α k).map (sumMarks A k)
  rw [← (markProductLaw_restrict D A K hAK hKD α hα hcap k).map_eq,
    Measure.map_map (measurable_sumMarks A k)
      (markProductLaw_restrict D A K hAK hKD α hα hcap k).measurable]
  rfl

/-- The observable continuous occupation law generated by marks on the larger set K. -/
noncomputable def projectedOccupationLaw (D A K : Finset Site) (hAK : A ⊆ K)
    (α : ℝ) (r : ℝ≥0) : Measure (A → ℝ) :=
  holdingKernel A ∘ₘ (projectedCountKernel D A K hAK α ∘ₘ poissonMeasure r)

 theorem projectedOccupationLaw_eq (D A K : Finset Site) (hAK : A ⊆ K) (hKD : K ⊆ D)
    (α : ℝ) (hα : 0 ≤ α) (hcap : α * capacity D K ≤ 1) (r : ℝ≥0) :
    projectedOccupationLaw D A K hAK α r = continuousOccupationLaw D A α r := by
  unfold projectedOccupationLaw continuousOccupationLaw
  rw [projectedCountKernel_eq D A K hAK hKD α hα hcap]

/-- Manuscript (3.6), including an arbitrary observation subset of the reference set. -/
theorem projectedOccupation_laplace (D A K : Finset Site) (hAK : A ⊆ K) (hKD : K ⊆ D)
    (α : ℝ) (hα : 0 ≤ α) (hcap : α * capacity D K ≤ 1) (r : ℝ≥0)
    (f : A → ℝ) (hf : ∀ z, 0 ≤ f z) :
    (∫ L, Real.exp (-(∑ z : A, f z * L z)) ∂projectedOccupationLaw D A K hAK α r) =
      Real.exp (-(r : ℝ) * α *
        ∑ z : A, f z * ((laplaceGreenMatrix D A f)⁻¹.mulVec 1) z) := by
  rw [projectedOccupationLaw_eq D A K hAK hKD α hα hcap r]
  exact continuousOccupation_laplace D A (hAK.trans hKD) α hα
    ((mul_le_mul_of_nonneg_left (capacity_mono_set D A K hAK hKD) hα).trans hcap) r f hf

end SRWTightness
