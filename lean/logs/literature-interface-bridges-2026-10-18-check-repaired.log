SRWTightness.normalizedEquilibriumAverage_covariance_min (D A K L : Finset SRWTightness.Site) (hKL : K ⊆ L)
  (hLA : L ⊆ A) (hAD : A ⊆ D) (hne : K.Nonempty)
  (hdis : ∀ (x : SRWTightness.Site), SRWTightness.equilibriumWeight D K x * SRWTightness.equilibriumWeight D L x = 0)
  (α g u : ℝ) (hα : 0 < α) (hg : 0 < g) (hu : 0 < u) (hcap : α * SRWTightness.capacity D A ≤ 1) (k : ℕ)
  (hk : u ^ 2 / 2 = ↑k) :
  ProbabilityTheory.covariance (SRWTightness.normalizedEquilibriumAverage D A K k α g u)
      (SRWTightness.normalizedEquilibriumAverage D A L k α g u) (SRWTightness.markProductLaw D A α k) =
    min (1 / (g * SRWTightness.capacity D K) - α / (2 * g)) (1 / (g * SRWTightness.capacity D L) - α / (2 * g))
SRWTightness.normalizedEquilibriumAverage_center_covariance (D A : Finset SRWTightness.Site) (b : SRWTightness.Site)
  (a : ℝ) (ha : 2 ≤ a) (hKA : SRWTightness.translateFinset b (SRWTightness.diskFinset a) ⊆ A) (hAD : A ⊆ D) (hb : b ∈ A)
  (α g u : ℝ) (hα : 0 < α) (hg : 0 < g) (hu : 0 < u) (hcap : α * SRWTightness.capacity D A ≤ 1) (k : ℕ)
  (hk : u ^ 2 / 2 = ↑k) :
  ProbabilityTheory.covariance (SRWTightness.normalizedMarkSum A k α g u ⟨b, hb⟩)
      (SRWTightness.normalizedEquilibriumAverage D A (SRWTightness.translateFinset b (SRWTightness.diskFinset a)) k α g
        u)
      (SRWTightness.markProductLaw D A α k) =
    1 / (g * SRWTightness.capacity D (SRWTightness.translateFinset b (SRWTightness.diskFinset a))) - α / (2 * g)
