SRWTightness.green_equilibrium_hitting (D K : Finset SRWTightness.Site) (hKD : K ⊆ D) (z : SRWTightness.Site) :
  ∑ x ∈ K, SRWTightness.killedGreen D z x * SRWTightness.equilibriumMeasure D K x =
    SRWTightness.pathLaw.real {ω | SRWTightness.setHittingTime K z 0 ω < SRWTightness.domainExit D z ω}
SRWTightness.referenceMarkLaw_isProbabilityMeasure (D K : Finset SRWTightness.Site) (α : ℝ) (hα : 0 ≤ α)
  (hcap : α * SRWTightness.capacity D K ≤ 1) : MeasureTheory.IsProbabilityMeasure (SRWTightness.referenceMarkLaw D K α)
SRWTightness.referenceMark_positive_mass (D K : Finset SRWTightness.Site) (hKD : K ⊆ D) (α : ℝ) (hα : 0 ≤ α)
  (hcap : α * SRWTightness.capacity D K ≤ 1) (z : ↥K) (l : ℕ) (hl : 1 ≤ l) :
  (SRWTightness.referenceMarkLaw D K α).real {Y | Y z = l} =
