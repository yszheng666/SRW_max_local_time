'SRWTightness.exists_uniform_equilibriumEnergy_spacing' depends on axioms: [propext, Classical.choice, Quot.sound]
SRWTightness.normalizedObservation_covariance_matrix {n : ℕ} (D A : Finset SRWTightness.Site)
  (K : Fin n → Finset SRWTightness.Site) (hKA : ∀ (i : Fin n), K i ⊆ A) (hAD : A ⊆ D) (hmono : Monotone K)
  (hdis :
    ∀ (i j : Fin n),
      i ≠ j →
        ∀ (x : SRWTightness.Site),
          SRWTightness.equilibriumWeight D (K i) x * SRWTightness.equilibriumWeight D (K j) x = 0)
  (z : ↥A) (hz : ∀ (i : Fin n), ↑z ∈ K i) (hzero : ∀ (i : Fin n), SRWTightness.equilibriumWeight D (K i) ↑z = 0)
  (α g u : ℝ) (hα : 0 < α) (hg : 0 < g) (hu : 0 < u) (hcap : α * SRWTightness.capacity D A ≤ 1) (k : ℕ)
  (hk : u ^ 2 / 2 = ↑k) :
  (Matrix.of fun i j =>
      ProbabilityTheory.covariance (SRWTightness.normalizedObservation D A K z k α g u i)
        (SRWTightness.normalizedObservation D A K z k α g u j) (SRWTightness.markProductLaw D A α k)) =
    (Matrix.of fun i j =>
        min (SRWTightness.observationEnergyTime D K (↑z) α g i) (SRWTightness.observationEnergyTime D K (↑z) α g j)) -
      Matrix.diagonal (SRWTightness.observationDiscreteError D K g)
SRWTightness.exists_uniform_equilibriumEnergy_spacing :
  ∃ B C,
    4 < B ∧
      0 < C ∧
        ∀ (R a α : ℝ),
          1 ≤ a →
            2 * (B * a) ≤ R →
              1 ≤
                  SRWTightness.equilibriumEnergyTime (SRWTightness.diskFinset R) (SRWTightness.diskFinset a) α
                      (2 / Real.pi) -
                    SRWTightness.equilibriumEnergyTime (SRWTightness.diskFinset R) (SRWTightness.diskFinset (B * a)) α
                      (2 / Real.pi) ∧
                SRWTightness.equilibriumEnergyTime (SRWTightness.diskFinset R) (SRWTightness.diskFinset a) α
                      (2 / Real.pi) -
                    SRWTightness.equilibriumEnergyTime (SRWTightness.diskFinset R) (SRWTightness.diskFinset (B * a)) α
                      (2 / Real.pi) ≤
                  C
