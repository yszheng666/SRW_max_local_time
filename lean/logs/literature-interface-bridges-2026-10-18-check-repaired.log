SRWTightness.prob_disk_max_lt_le_pow_real {a R : ℝ} (ha : 0 ≤ a) (J k : ℕ) (hgeom : ↑J * (a + 1) < R) :
  SRWTightness.pathLaw.real {ω | SRWTightness.diskMax R ω < k} ≤
    SRWTightness.pathLaw.real {ω | SRWTightness.diskMax a ω < k} ^ J
