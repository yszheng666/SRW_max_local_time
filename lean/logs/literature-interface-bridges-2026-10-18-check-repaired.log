SRWTightness.prob_scaled_disk_comparison_failure (A : ℝ) (hA : 1 < A) (n : ℕ) (hn : 1 ≤ n) :
  SRWTightness.pathLaw.real {ω | ¬(SRWTightness.exitTime (√↑n / A) ω ≤ ↑n ∧ ↑n ≤ SRWTightness.exitTime (A * √↑n) ω)} ≤
    2 / A ^ 2 + 2 / (A * √↑n) + 1 / ↑n
SRWTightness.ae_scaled_disk_time_sandwich (A : ℝ) (hA : 1 < A) (n : ℕ) :
  ∀ᵐ (ω : SRWTightness.Sample) ∂SRWTightness.pathLaw,
    SRWTightness.exitTime (√↑n / A) ω ≤ ↑n ∧ ↑n ≤ SRWTightness.exitTime (A * √↑n) ω →
      SRWTightness.diskMax (√↑n / A) ω ≤ SRWTightness.maxLocalTime ω n ∧
        SRWTightness.maxLocalTime ω n ≤ SRWTightness.diskMax (A * √↑n) ω
SRWTightness.inclusive_tightness_of_time (ht : SRWTightness.TimeTightnessClaim) :
  SRWTightness.InclusiveTimeTightnessClaim
