  |1 /
          (2 / Real.pi *
            SRWTightness.capacity (SRWTightness.translateFinset b (SRWTightness.diskFinset (Real.exp 1 * m + H)))
              (SRWTightness.translateFinset b (SRWTightness.diskFinset a))) -
        (Real.log m - Real.log a)| ≤
    SRWTightness.diskGreenEnergyConstant / (2 / Real.pi) + Real.log 4
