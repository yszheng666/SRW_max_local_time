SRWTightness.diskGreen_diagonal_interior_log_bound (R : ℝ) (hR : 4 ≤ R) (x : SRWTightness.Site)
  (hx : SRWTightness.normSq x ≤ (R / 2) ^ 2) :
  |SRWTightness.diskGreen R x x - 2 / Real.pi * Real.log R| ≤
    SRWTightness.diskGreenEnergyConstant + 2 / Real.pi * Real.log 2
SRWTightness.disk_one_point_log_tail :
  ∃ C,
    0 < C ∧
      ∀ (R : ℝ),
        4 ≤ R →
          0 < 2 / Real.pi * Real.log R - SRWTightness.diskDiagonalError →
            ∀ (x : SRWTightness.Site),
              SRWTightness.normSq x ≤ (R / 2) ^ 2 →
                ∀ (k : ℕ),
                  1 ≤ k →
                    SRWTightness.pathLaw.real {ω | k ≤ SRWTightness.localTime ω (SRWTightness.exitSteps R ω) x} ≤
                      C * (1 + Real.log (R / max (√(SRWTightness.normSq x)) 1)) /
                          (2 / Real.pi * Real.log R - SRWTightness.diskDiagonalError) *
                        Real.exp (-↑(k - 1) / (2 / Real.pi * Real.log R + SRWTightness.diskDiagonalError))
