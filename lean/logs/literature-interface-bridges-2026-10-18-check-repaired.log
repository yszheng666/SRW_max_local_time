SRWTightness.disk_one_point_tail (R : ℝ) (x : SRWTightness.Site) (hx : x ∈ SRWTightness.disk R) (k : ℕ) (hk : 1 ≤ k) :
  SRWTightness.pathLaw.real {ω | k ≤ SRWTightness.localTime ω (SRWTightness.exitSteps R ω) x} =
    SRWTightness.diskGreen R 0 x / SRWTightness.diskGreen R x x * (1 - 1 / SRWTightness.diskGreen R x x) ^ (k - 1)
